# Clouderator Environment Configuration
PORT=3000

# Groq Cloud API Key (Get a free key at https://console.groq.com/keys)
# Powers ultra-fast, multi-turn LLM architectural reasoning via LLaMA 3.3
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Google Gemini API Key for dynamic multi-turn LLM reasoning
# If left empty, Clouderator automatically runs with its built-in Domain Architecture Engine!
GEMINI_API_KEY=

# Default Target Budget in USD
MONTHLY_BUDGET=2500

